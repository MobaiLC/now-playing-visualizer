[Unit]
Description=Now Playing Visualizer helper (CAVA and per-app audio)
After=pipewire-pulse.service plasma-plasmashell.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/plasma/plasmoids/com.github.mobailc.nowplayingvisualizer/contents/code/helper.py --service
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
