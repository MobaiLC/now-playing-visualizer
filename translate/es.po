#: package/contents/settings/settings.qml:19
msgid "Now Playing Visualizer — Settings"
msgstr "Now Playing Visualizer — Ajustes"

#: package/contents/settings/settings.qml:69
msgid "Discard the unapplied changes?"
msgstr "¿Descartar los cambios sin aplicar?"

#: package/contents/settings/settings.qml:95
msgid ""
"Can't reach the helper. Start it with: systemctl --user start nowplaying-viz"
msgstr "No se puede conectar con el helper. Inícialo con: systemctl --user start nowplaying-viz"

#: package/contents/settings/settings.qml:103
msgid "If it still doesn't connect, run: nowplaying-viz doctor"
msgstr "Si sigue sin conectar, ejecuta: nowplaying-viz doctor"

#: package/contents/settings/settings.qml:143
msgid "The helper didn't confirm the save. The changes are not applied yet."
msgstr "El helper no confirmó el guardado. Los cambios aún no se han aplicado."

#: package/contents/settings/settings.qml:150
msgid "Cancel"
msgstr "Cancelar"

#: package/contents/settings/settings.qml:155
msgid "Apply"
msgstr "Aplicar"

#: package/contents/settings/settings.qml:161
msgid "OK"
msgstr "Aceptar"

#: package/contents/ui/AudioPage.qml:70
msgid ""
"The visualizer listens to the player shown in the widget, whichever it is."
msgstr ""
"El visualizador escucha el reproductor que muestra el widget, sea cual sea."

#: package/contents/ui/AudioPage.qml:72
msgid "No app selected: the visualizer listens to the whole system."
msgstr "Ninguna aplicación marcada: el visualizador escucha todo el sistema."

#: package/contents/ui/AudioPage.qml:73
msgid ""
"The visualizer only listens to the selected apps. Apps show up here while "
"they are playing sound."
msgstr ""
"El visualizador solo escucha las aplicaciones marcadas. Aparecen aquí cuando "
"están reproduciendo sonido."

#: package/contents/ui/AudioPage.qml:77
msgid "Follow the player shown in the widget"
msgstr "Seguir al reproductor que muestra el widget"

#: package/contents/ui/AudioPage.qml:102
msgid "%1 (not playing now)"
msgstr "%1 (sin sonar ahora)"

#: package/contents/ui/AudioPage.qml:111
msgid "Connecting to the helper…"
msgstr "Conectando con el helper…"

#: package/contents/ui/AudioPage.qml:117
msgid "Refresh list"
msgstr "Actualizar lista"

#: package/contents/ui/AudioPage.qml:122 package/contents/ui/DesignPage.qml:743
msgid "Open config.json"
msgstr "Abrir config.json"

#: package/contents/ui/DesignPage.qml:98
msgid ""
"config.json has an error, so nothing can be saved. Fix it, or run nowplaying-"
"viz check to see where it is."
msgstr ""
"config.json tiene un error, así que no se puede guardar nada. Corrígelo, o "
"ejecuta nowplaying-viz check para ver dónde está."

#: package/contents/ui/DesignPage.qml:115
msgid "Design exported as \"%1\"."
msgstr "Diseño exportado como \"%1\"."

#: package/contents/ui/DesignPage.qml:117
msgid ""
"Imported as \"%2\". %1 setting in the file was not valid and was left out."
msgid_plural ""
"Imported as \"%2\". %1 settings in the file were not valid and were left out."
msgstr[0] ""
"Importado como \"%2\". %1 ajuste del archivo no era válido y se ha omitido."
msgstr[1] ""
"Importado como \"%2\". %1 ajustes del archivo no eran válidos y se han "
"omitido."

#: package/contents/ui/DesignPage.qml:119
msgid "Imported as \"%1\"."
msgstr "Importado como \"%1\"."

#: package/contents/ui/DesignPage.qml:120
msgid "That file can't be used: pick a local file ending in .json."
msgstr ""
"Ese archivo no se puede usar: elige un archivo local que termine en .json."

#: package/contents/ui/DesignPage.qml:121
msgid "The file could not be read."
msgstr "No se pudo leer el archivo."

#: package/contents/ui/DesignPage.qml:122
msgid "The file is too big to be a preset."
msgstr "El archivo es demasiado grande para ser un preset."

#: package/contents/ui/DesignPage.qml:123
msgid "The file is not valid JSON."
msgstr "El archivo no es un JSON válido."

#: package/contents/ui/DesignPage.qml:124
msgid "The file is not a Now Playing Visualizer preset."
msgstr "El archivo no es un preset de Now Playing Visualizer."

#: package/contents/ui/DesignPage.qml:125
msgid "The file could not be saved there."
msgstr "No se pudo guardar el archivo ahí."

#: package/contents/ui/DesignPage.qml:126
msgid ""
"You have reached the limit of 100 saved presets. Delete one before importing."
msgstr ""
"Has llegado al límite de 100 presets guardados. Borra uno antes de importar."

#: package/contents/ui/DesignPage.qml:134
msgid "Export design"
msgstr "Exportar diseño"

