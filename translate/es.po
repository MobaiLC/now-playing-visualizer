msgid "Drop your changes and use the preset as it is"
msgstr "Quita tus cambios y deja el preset tal cual"

#: package/contents/ui/DesignPage.qml:630
msgid "Delete this preset"
msgstr "Borrar este preset"

#: package/contents/ui/DesignPage.qml:650
msgid "Save current design as:"
msgstr "Guardar el diseño actual como:"

#: package/contents/ui/DesignPage.qml:655
msgid "preset name"
msgstr "nombre del preset"

#: package/contents/ui/DesignPage.qml:659
msgid "Save"
msgstr "Guardar"

#: package/contents/ui/DesignPage.qml:670
msgid "Import preset…"
msgstr "Importar preset…"

#: package/contents/ui/DesignPage.qml:678
msgid "Export design…"
msgstr "Exportar diseño…"

#: package/contents/ui/DesignPage.qml:680
msgid "Saves the design as it looks now to a file you can share"
msgstr ""
"Guarda el diseño tal como se ve ahora en un archivo que puedes compartir"

#: package/contents/ui/DesignPage.qml:701
msgid ""
"You have reached the limit of 100 saved presets. Delete one, or save over an "
"existing name."
msgstr ""
"Has llegado al límite de 100 presets guardados. Borra alguno o guarda encima "
"de uno que ya exista."

#: package/contents/ui/DesignPage.qml:714
msgid ""
"Picking a preset replaces your bar settings; Undo brings them back. Nothing "
"is kept until you press Apply or OK."
msgstr ""
"Elegir un preset sustituye tus ajustes de barras; Deshacer los recupera. "
"Nada se guarda hasta que pulses Aplicar o Aceptar."

